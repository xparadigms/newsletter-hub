<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Filled from the SUPABASE_PUBLISHABLE_KEY build setting; see SupabaseClient. -->
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<!-- Only HTTPS to Supabase: no export-compliance questions on each upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- thebrief://post/<section>/<slug> opens an issue. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.heechangkang.thebrief</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>thebrief</string>
			</array>
		</dict>
	</array>
	<!-- Read-aloud continues with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
