<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications, through Apple's production service — the one
	     TestFlight and App Store builds use, and the only one the App Store
	     profile (ios.yml) allows. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
